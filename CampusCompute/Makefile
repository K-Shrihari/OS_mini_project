# CampusCompute - build file (Linux / Ubuntu / WSL Ubuntu)
CC      = gcc
CFLAGS  = -std=gnu11 -Wall -Wextra -O2 -pthread
LDLIBS  = -pthread -lrt
TARGET  = campuscompute
SRCS    = main.c util.c scheduler.c logger.c ipc.c banker.c worker.c limits.c
OBJS    = $(SRCS:.c=.o)

.PHONY: all clean test demo

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $(OBJS) $(LDLIBS)

%.o: %.c campus.h
	$(CC) $(CFLAGS) -c $< -o $@

test: $(TARGET)
	bash tests/run_tests.sh

demo: $(TARGET)
	./$(TARGET) demo

# Removes only files generated by this project's build and runs.
clean:
	rm -f $(OBJS) $(TARGET) campus.log
